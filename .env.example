# ShinoGraph Configuration
# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: Claude model (default: claude-sonnet-4-20250514)
# SHINOGRAPH_MODEL=claude-sonnet-4-20250514

# Optional: Database path (default: shinograph.db)
# SHINOGRAPH_DB=shinograph.db

# Optional: ChromaDB storage (default: ./chroma_data)
# CHROMA_PERSIST_DIR=./chroma_data

# Optional: Server host/port
# SHINOGRAPH_HOST=0.0.0.0
# SHINOGRAPH_PORT=8000
