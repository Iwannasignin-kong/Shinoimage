# ShinoGraph Configuration
# Copy this file to .env and fill in your values

# Required: AI API Key
API_KEY=sk-xxx

# Required: API 地址（OpenAI 兼容接口）
PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: 视觉模型（解析截图用，默认 qwen-vl-plus）
# SHINOGRAPH_MODEL=qwen-vl-plus

# Optional: 文本模型（问答/解析文本用，默认 qwen-plus）
# SHINOGRAPH_TEXT_MODEL=qwen-plus

# Optional: Database path (default: shinograph.db)
# SHINOGRAPH_DB=shinograph.db

# Optional: ChromaDB storage (default: ./chroma_data)
# CHROMA_PERSIST_DIR=./chroma_data

# Optional: Server host/port
# SHINOGRAPH_HOST=0.0.0.0
# SHINOGRAPH_PORT=8000
